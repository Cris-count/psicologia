# Puertos Docker
APP_PORT=8080
DEV_PORT=4200
API_PORT=3000

# Gemini (rúbrica PDF + calificación + asistente docente)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Enlace que aparece en los correos a estudiantes
# Dev con ng serve: http://localhost:4200
# Docker producción: http://localhost:8080
APP_PUBLIC_URL=http://localhost:8080

# ═══════════════════════════════════════════════════════════
# GMAIL SMTP — completa las 3 líneas de abajo
# ═══════════════════════════════════════════════════════════
#
# PASO A — Verificación en 2 pasos (obligatorio):
#   https://myaccount.google.com/security
#
# PASO B — Contraseña de aplicación (NO es tu clave de Gmail):
#   https://myaccount.google.com/apppasswords
#   → Correo → Dispositivo: "MIND-SPHERE" → Generar
#   → Copia los 16 caracteres (puedes pegarlos sin espacios)
#
# PASO C — Pega aquí y guarda el archivo:
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MIND-SPHERE <tu-correo@gmail.com>