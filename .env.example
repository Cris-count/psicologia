# Puertos Docker
APP_PORT=8080
DEV_PORT=4200
API_PORT=3000

# Gemini (rúbrica PDF + calificación + asistente docente)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# URL pública de la app (enlaces en correos)
# Dev: http://localhost:4200  |  Producción Docker: http://localhost:8080
APP_PUBLIC_URL=http://localhost:4200

# ── Gmail SMTP (notificaciones a estudiantes) ───────────────
# Requiere verificación en 2 pasos + contraseña de aplicación:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mind.spehere@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=MIND-SPHERE <mind.spehere@gmail.com>
